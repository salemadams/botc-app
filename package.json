{
  "name": "blood-on-the-clocktower-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "npm run start --workspace=client",
    "server": "npm run dev --workspace=server",
    "dev": "npm run client & npm run server",
    "client:android": "npm run android --workspace=client",
    "client:ios": "npm run ios --workspace=client",
    "client:web": "npm run web --workspace=client",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "install:all": "npm install"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
